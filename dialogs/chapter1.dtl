label get_up
if {chapter1.intro_played} == false:
	join ye_li center
	do GameManager.lock_player_control(true)
	ye_li: *哈欠*
	ye_li: 嗯……？
	ye_li: 这张纸条，是什么？
	[clear time="1.0"]
do GameManager.lock_player_control(false)
set {chapter1.intro_played} = true
[end_timeline]
label start
do GameManager.lock_player_control(true)
li: 先看看床头柜上是什么吧
do GameManager.lock_player_control(false)
[end_timeline]

label leave_bedroom_before_note
li: 先看看床头柜上是什么吧
[end_timeline]

label read_note
do GameManager.lock_player_control(true)
“我们有事出门一趟，你在家照顾好自己”
ye_li: 看来是把门反锁了
ye_li: 但是我想出去一趟来着
ye_li: 去找找钥匙在哪吧
do GameManager.lock_player_control(false)
[end_timeline]

label get_medicine
do GameManager.lock_player_control(true)
ye_li: 嗯……
do GameManager.lock_player_control(false)
[end_timeline]

label read_instruction
do GameManager.lock_player_control(true)
ye_li: 怪事，怎么看不清
do GameManager.lock_player_control(false)
[end_timeline]
label bathroom_clue_found
# 浴室线索
if Chapter.get_data("collected_clues", []).has("7"):
	ye_li: 是不是能拼一起？
	ye_li: 合一块好像是……
	ye_li: “在厨房的壁橱里”？
	li: 去看看吧
	set {chapter1.combined_clue} = true
else:
	ye_li: 这句话缺了几个字？……莫名其妙
[end_timeline]

